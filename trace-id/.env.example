# SERPAPI_API_KEY — Get from https://serpapi.com/
SERPAPI_API_KEY=

# Google Cloud Vision — Path to service account JSON key
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_APPLICATION_CREDENTIALS=

# Polygon Amoy testnet RPC — Use https://rpc-amoy.polygon.technology/ or Alchemy/Infura
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/

# Your wallet private key (WITHOUT 0x prefix, or with — both accepted)
# NEVER commit this value. Use a dedicated testnet wallet with no real funds.
PRIVATE_KEY=

# Deployed EvidenceRegistry contract address on Polygon Amoy
# Run: python -m app.blockchain.deploy   to deploy and get this address
CONTRACT_ADDRESS=

# ──────────────────────────────────────────────
# Similarity thresholds — calibrated per model
# InsightFace buffalo_l ArcFace threshold (default: 0.60)
FACE_SIMILARITY_THRESHOLD=0.60

# DINOv2 ViT-S/14 cosine similarity threshold
VISUAL_SIMILARITY_THRESHOLD=0.60

# ──────────────────────────────────────────────
# Candidate scoring weights (must sum to 1.0)
FACE_WEIGHT=0.60
VISUAL_WEIGHT=0.30
DISCOVERY_WEIGHT=0.10

# Maximum candidates to evaluate per pipeline run
MAX_CANDIDATES=10

# ──────────────────────────────────────────────
# Set to "true" to use mocked search results (no API keys required)
# Mock mode clearly labels all output as MOCK — never used for real claims
MOCK_MODE=false
